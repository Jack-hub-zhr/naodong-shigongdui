# ============================================================
# ForgeCrew · 服务端配置
# ------------------------------------------------------------
# 应用通过自带服务端（server/index.mjs）调用上游服务。
# 密钥只放在服务器环境变量里，不会打包进浏览器代码。
#
# 本地运行：
#   npm run build:web && DEEPSEEK_API_KEY=sk-xxx npm run serve
# 打开 http://localhost:3000
# ============================================================

# ---- 可选：配置后优先使用 ----
DEEPSEEK_API_KEY=

# ---- 可选：覆盖默认可用的免费通道 ----
FREE_BASE_URL=
FREE_MODEL=

# ---- 服务端端口（Render 会自动注入 PORT）----
PORT=3000

# ---- 前端调用地址 ----
# 同源部署时留空；前后端分离时填写完整地址
VITE_API_BASE=

# ---- 本地通知（可选）----
# 0 可关闭「需要你确认 / 交付」的本地通知
APP_NOTIFICATIONS=1
