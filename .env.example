# ============================================================
# ForgeCrew · 服务端配置
# ------------------------------------------------------------
# 应用通过自带服务端（server/index.mjs）调用上游服务。
# 密钥只放在服务器环境变量里，不会打包进浏览器代码。
#
# 本地运行：
#   PORT=3001 node server/index.mjs
# 打开 http://localhost:3001
# ============================================================

# ---- 推荐：配置一个免费 Key 后优先使用 ----
# Groq 免费层：约 30 RPM、1000 次/天，模型 qwen/qwen3.8-27b
GROQ_API_KEY=
# 阿里云百炼：新账号通常有 90 天免费额度，模型 qwen-plus
DASHSCOPE_API_KEY=
# 硅基流动：Qwen3-8B 长期免费（约 30 RPM / 60K TPM），国内直连
SILICONFLOW_API_KEY=
# 魔搭：备用 Qwen/Qwen3.8-27B
MODELSCOPE_API_KEY=
# OpenRouter：备用 qwen/qwen3-coder:free
OPENROUTER_API_KEY=

# ---- 可选：覆盖百炼兼容端点 ----
DASHSCOPE_BASE_URL=

# ---- 可选：OVHcloud 注册版 Key（匿名额度很小）----
OVH_API_KEY=

# ---- 服务端端口（Render 会自动注入 PORT）----
PORT=3000

# ---- 前端调用地址 ----
# 同源部署时留空；前后端分离时填写完整地址
VITE_API_BASE=

# ---- 账号库路径 ----
DATA_FILE=data/accounts.json

# ---- 本地通知（可选）----
# 0 可关闭「需要你确认 / 交付」的本地通知
APP_NOTIFICATIONS=1
